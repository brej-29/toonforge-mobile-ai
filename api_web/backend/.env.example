# Example environment variables for the FastAPI backend.
# Do NOT commit real secrets; this file is for documentation only.

APP_NAME="Mobile AI Cartoon Generation API"
APP_VERSION="0.2.0"
API_VERSION="v1"
ENVIRONMENT="local"
LOG_LEVEL="INFO"

# Optional git SHA for traceability
# GIT_SHA="abc123def"

# Gradio Space configuration for cloud mode (mode=cloud)
# GRADIO_SPACE_ID="username/toonforge-cartoonizer"
# GRADIO_API_NAME="/predict"

# Directory for cached TFLite models (default matches cartoonizer artifacts layout)
# MODEL_CACHE_DIR="./models/artifacts/downloaded"

# Maximum upload size for images (in MB)
# MAX_UPLOAD_MB="10"
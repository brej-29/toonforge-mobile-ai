{
  "name": "toonforge-studio",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "test:e2e": "playwright test",
    "check:attribution": "node scripts/check-publication.mjs",
    "smoke": "node scripts/smoke.mjs",
    "mcp": "tsx scripts/mcp-server.ts"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
